# ClearNode WebSocket URL (Yellow Network)
# Production: wss://clearnet.yellow.com/ws
# Sandbox:    wss://clearnet-sandbox.yellow.com/ws
CLEARNODE_URL=wss://clearnet-sandbox.yellow.com/ws

# Enable Yellow partner message handling
YELLOW_PARTNER_ENABLED=true

# Server-side Yellow auth (EIP-712)
# YELLOW_SIGNER_PRIVATE_KEY=0x...
# YELLOW_AUTH_SCOPE=console
# YELLOW_AUTH_EXPIRE_SEC=86400

# HTTP port (default 3333)
# PORT=3333

# CORS: comma-separated allowed origins. If empty, CORS is open (dev mode).
# CORS_ORIGINS=http://localhost:3000

# PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/custody_gateway

# Service-to-service auth. If not set, all endpoints are open (dev mode).
# API_KEY=your-secret-api-key

# 32-byte hex master key for AES-256-GCM encryption of private keys in DB.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# KEY_ENCRYPTION_MASTER_KEY=<64-char-hex>
