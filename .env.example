# ClearNode WebSocket URL (Yellow Network)
# Production: wss://clearnet.yellow.com/ws
# Sandbox:    wss://clearnet-sandbox.yellow.com/ws
# Local:      ws://localhost:8000/ws
CLEARNODE_URL=wss://clearnet-sandbox.yellow.com/ws

# Enable Yellow partner message handling (true/false)
YELLOW_PARTNER_ENABLED=true

# Optional: server-side Yellow auth (EIP-712). If set, custody-gateway runs auth flow on connect and stores JWT.
# YELLOW_SIGNER_PRIVATE_KEY=0x...   # EVM private key (0x-prefixed, 64 hex chars)
# YELLOW_AUTH_APP_NAME=custody-gateway  # application name (used as EIP-712 domain.name)
# YELLOW_AUTH_SCOPE=console             # auth scope
# YELLOW_AUTH_EXPIRE_SEC=86400          # session TTL in seconds (expires_at = now + this)

# Optional: HTTP port (default 3333)
# PORT=3333

# CORS: comma-separated allowed origins. If empty, CORS is open (dev mode).
# CORS_ORIGINS=http://10.0.0.1:3000,http://192.168.1.100:3000

# DATABASE_URL=postgresql://user:password@localhost:5432/custody_gateway
# CLEARNODE_SIGNER_ADDRESS=0x...       # optional: verify incoming message signatures
# TIMESTAMP_MAX_DRIFT_MS=300000       # optional: max clock drift ms (default 5 min)
# WS_RECONNECT_MAX_DELAY_MS=30000     # optional: max reconnect delay ms

# ─── Service-to-service auth ───
# If set, all endpoints (except /health) require X-API-Key header.
# If not set, all endpoints are open (dev mode).
# API_KEY=your-secret-api-key

# ─── Key encryption ───
# 32-byte hex master key for AES-256-GCM encryption of private keys in DB.
# If set, PostgresKeyProvider is used (keys persisted in DB).
# If not set, InMemoryKeyProvider is used (keys from env only, lost on restart).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# KEY_ENCRYPTION_MASTER_KEY=<64-char-hex>
