generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum YellowSessionStatus {
  active
  closed
}

enum SignedStateIntent {
  OPERATE
  INITIALIZE
  RESIZE
  FINALIZE
}

enum ChannelStateStatus {
  active
  closed
  challenged
}

model YellowSession {
  id        String             @id @default(cuid())
  sessionId String             @unique
  status    YellowSessionStatus @default(active)
  partnerId String?
  userId    String?
  metadata  Json?
  createdAt DateTime           @default(now())
  closedAt  DateTime?
}

model SignedState {
  id           String           @id @default(cuid())
  channelId    String
  sessionId    String?
  stateVersion Int
  intent       SignedStateIntent
  stateData    Json // full state snapshot
  allocations  Json // fund distribution
  signatures   Json // array of 0x-prefixed hex
  rawMessage   String // original signed JSON for dispute
  createdAt    DateTime         @default(now())

  @@index([channelId])
  @@index([sessionId])
}

model ChannelState {
  id           String            @id @default(cuid())
  channelId    String            @unique
  status       ChannelStateStatus @default(active)
  participants Json // [address, address]
  chainId      Int?
  token        String?
  balance      Json?
  lastUpdate   DateTime          @default(now())
  createdAt    DateTime          @default(now())
}

// ─── Session Invitations ──────────────────────────────────

enum SessionInvitationStatus {
  pending
  accepted
  rejected
}

model SessionInvitation {
  id              String                  @id @default(cuid())
  token           String
  initiatorAddr   String
  inviteeAddr     String
  amountInitiator String
  amountInvitee   String
  status          SessionInvitationStatus @default(pending)
  sessionId       String?
  createdAt       DateTime                @default(now())
  respondedAt     DateTime?

  @@index([inviteeAddr, status])
  @@index([initiatorAddr])
}

// ─── Account & Key Management ─────────────────────────────

model ManagedWallet {
  id        String   @id @default(cuid())
  userId    String
  address   String   @unique
  label     String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model ManagedKey {
  id           String   @id @default(cuid())
  address      String   @unique
  encryptedKey String   // AES-256-GCM ciphertext (hex)
  iv           String   // initialization vector (hex)
  tag          String   // GCM auth tag (hex)
  createdAt    DateTime @default(now())
}
