generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum YellowSessionStatus {
  active
  closed
}

model YellowSession {
  id        String             @id @default(cuid())
  sessionId String             @unique
  status    YellowSessionStatus @default(active)
  partnerId String?
  userId    String?
  metadata  Json?
  createdAt DateTime           @default(now())
  closedAt  DateTime?
}

// ─── Session Invitations ──────────────────────────────────

enum SessionInvitationStatus {
  pending
  accepted
  rejected
}

model SessionInvitation {
  id              String                  @id @default(cuid())
  token           String
  initiatorAddr   String
  inviteeAddr     String
  amountInitiator String
  amountInvitee   String
  status          SessionInvitationStatus @default(pending)
  sessionId       String?
  createdAt       DateTime                @default(now())
  respondedAt     DateTime?

  @@index([inviteeAddr, status])
  @@index([initiatorAddr])
}

// ─── Account & Key Management ─────────────────────────────

model ManagedWallet {
  id        String   @id @default(cuid())
  userId    String
  address   String   @unique
  label     String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model ManagedKey {
  id           String   @id @default(cuid())
  address      String   @unique
  encryptedKey String   // AES-256-GCM ciphertext (hex)
  iv           String   // initialization vector (hex)
  tag          String   // GCM auth tag (hex)
  createdAt    DateTime @default(now())
}
